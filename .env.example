# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Snowflake (role WCM_READER is created by examples/snowflake_demo.sql) ---
# Either name a Snowflake CLI connection (it supplies account and sign-in; values below
# override it) or set the account and user directly.
SNOWFLAKE_CONNECTION_NAME=
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=WCM_READER
SNOWFLAKE_WAREHOUSE=WCM_XS
SNOWFLAKE_DATABASE=WCM_DEMO
SNOWFLAKE_SCHEMA=SHIPPING
# Auth: key pair (recommended) or password. Leave both empty to sign in through the browser.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=
# PII tags must be readable (Enterprise edition). Set to false only if you flag PII in the
# curated catalog instead.
SNOWFLAKE_REQUIRE_PII_TAGS=true
# Seconds before the warehouse cancels a statement.
SNOWFLAKE_STATEMENT_TIMEOUT_S=60

# --- Databricks (SQL warehouse > Connection details) ---
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=wcm_demo
DATABRICKS_REQUIRE_PII_TAGS=true
# The token is only sent to Databricks domains. Set to true for private link or a proxy.
DATABRICKS_ALLOW_CUSTOM_HOST=false

# --- Evaluation (uv run python -m evals; see README > Evaluation) ---
# Only the key for the provider you pass with --provider is needed. The harness reads it
# from the environment or this file and never prints it. Ollama needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# --provider moonshot (alias: kimi)
MOONSHOT_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# For --provider custom --base-url ..., name your own variable with --api-key-env NAME.

# --- Demo ---
# Where --demo builds its database (default: a per-version folder in the temp directory).
# Read from the real environment only, not from this file.
# WCM_DEMO_DIR=
