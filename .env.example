# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Snowflake (role WCM_READER is created by examples/snowflake_demo.sql) ---
# Either name a Snowflake CLI connection (it supplies account and sign-in; values below
# override it) or set the account and user directly.
SNOWFLAKE_CONNECTION_NAME=
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=WCM_READER
SNOWFLAKE_WAREHOUSE=WCM_XS
SNOWFLAKE_DATABASE=WCM_DEMO
SNOWFLAKE_SCHEMA=SHIPPING
# Auth: key pair (recommended) or password. Leave both empty to sign in through the browser.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=

# --- Databricks (SQL warehouse > Connection details) ---
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=wcm_demo
